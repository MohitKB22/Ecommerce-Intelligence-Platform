# ---------------------------------------------------------------------------
# E-Commerce Intelligence - environment template
# Copy to .env and edit. NEVER commit the resulting .env file.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- application ----------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                      # false gives human-readable console logs
DEBUG=false

# ---- database -------------------------------------------------------------
# PostgreSQL (production / docker compose):
#   DATABASE_URL=postgresql+psycopg://eci:eci_password@localhost:5432/ecommerce_intelligence
# SQLite (zero-setup local development) - the default when unset:
DATABASE_URL=sqlite:///./data/ecommerce.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- cache ----------------------------------------------------------------
# Leave empty to use the in-process cache instead of Redis.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# ---- vector database ------------------------------------------------------
# Empty means the exact in-process numpy index is used (recommended to start).
# For pgvector: VECTOR_DB_URL=postgresql+psycopg://eci:eci_password@localhost:5433/vectors
VECTOR_DB_URL=
VECTOR_DIM=128

# ---- security -------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-insecure-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# Administrator account created by the seed script.
ADMIN_EMAIL=admin@ecommerce-intelligence.local
ADMIN_PASSWORD=admin-change-me

# ---- machine learning -----------------------------------------------------
MODEL_PATH=./ml/models
DATA_PATH=./data
ML_AUTOLOAD=true                   # preload model artifacts at API startup
ML_DRIFT_THRESHOLD=0.2             # relative change before drift is flagged

# Embedding backend: tfidf-svd (default, no downloads) or sentence-transformers
# EMBEDDING_BACKEND=tfidf-svd
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- background workers ---------------------------------------------------
# Empty runs the in-process thread scheduler instead of Celery.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- recommendation blend weights (must be tuned together) ----------------
# Defaults are overridden by weights fitted during training.
REC_W_COLLABORATIVE=0.35
REC_W_CONTENT=0.25
REC_W_POPULARITY=0.15
REC_W_PERSONALIZATION=0.15
REC_W_BUSINESS=0.10

# ---- search ranking weights ----------------------------------------------
RANK_W_TEXT=0.30
RANK_W_SEMANTIC=0.25
RANK_W_POPULARITY=0.12
RANK_W_RATING=0.10
RANK_W_CONVERSION=0.10
RANK_W_PERSONAL=0.08
RANK_W_AVAILABILITY=0.05

# ---- docker compose port mapping -----------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=eci
POSTGRES_PASSWORD=eci_password
POSTGRES_DB=ecommerce_intelligence

# ---- frontend build-time --------------------------------------------------
# Empty means same-origin (nginx proxies /api to the backend).
VITE_API_BASE_URL=
